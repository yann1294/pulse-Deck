{
  "name": "pulsedesk",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered customer support ticketing SaaS MVP.",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:client": "pnpm --filter @pulsedesk/client dev",
    "dev:server": "pnpm --filter @pulsedesk/server dev",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @pulsedesk/server db:migrate",
    "db:generate": "pnpm --filter @pulsedesk/server db:generate",
    "db:studio": "pnpm --filter @pulsedesk/server db:studio",
    "db:reset": "pnpm --filter @pulsedesk/server db:reset",
    "db:seed": "pnpm --filter @pulsedesk/server db:seed",
    "demo:seed": "pnpm --filter @pulsedesk/server demo:seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
