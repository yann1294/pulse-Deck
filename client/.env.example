# PulseDesk client environment
# Copy this file to .env.local for local development.

# Public API endpoint used by the browser client.
# Next.js reads NEXT_PUBLIC_*, Vite reads VITE_*; keep both in sync if the stack is undecided.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Public app URL for redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Optional public product metadata.
NEXT_PUBLIC_APP_NAME=PulseDesk
VITE_APP_NAME=PulseDesk
