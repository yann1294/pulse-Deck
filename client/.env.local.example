# PulseDesk client local environment.
# Copy this file to .env.local inside client/ for local Next.js development.
# Do not commit real Clerk secrets.

# Clerk publishable key used by the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk secret key used only by server-side Next.js code.
# Keep this secret out of Git.
CLERK_SECRET_KEY=sk_test_replace_me

# Local NestJS API URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
