# PulseDesk local Docker defaults.
# Copy this file to .env if you want docker compose variable overrides.
# These values are for local development only and are not production secrets.

COMPOSE_PROJECT_NAME=pulsedesk

# PostgreSQL local container defaults.
POSTGRES_DB=pulsedesk
POSTGRES_USER=pulsedesk
POSTGRES_PASSWORD=pulsedesk
POSTGRES_PORT=5432

# Redis local container defaults.
REDIS_PORT=6379

# Optional NestJS server container.
NODE_ENV=production
SERVER_PORT=3001
CLIENT_URL=http://localhost:3000

# Optional server secrets when running the NestJS container.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTY=http://localhost:3000
GEMINI_API_KEY=replace_me
GEMINI_GENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Optional flag used by the demo seed command.
DEMO_MODE=false
