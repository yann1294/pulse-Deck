# PulseDesk server environment
# Copy this file to .env for local development.

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL with pgvector. These match docker-compose.yml defaults.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=pulsedesk
POSTGRES_USER=pulsedesk
POSTGRES_PASSWORD=pulsedesk_dev_password
DATABASE_URL=postgresql://pulsedesk:pulsedesk_dev_password@localhost:5432/pulsedesk

# Redis for queues, cache, rate limits, and session-adjacent workloads.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth and security. Replace all secrets before deploying.
JWT_SECRET=replace_with_at_least_32_random_characters
SESSION_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_32_byte_base64_key

# AI provider credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Email delivery for invites, notifications, and password flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PulseDesk <support@pulsedesk.local>"

# Operational controls.
LOG_LEVEL=info
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
