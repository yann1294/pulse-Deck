# PulseDesk server local environment.
# Copy this file to .env inside server/ for local NestJS development.
# Do not commit real secrets or production credentials.

# Local API port.
PORT=4000

# Local PostgreSQL connection string matching docker-compose defaults.
DATABASE_URL=postgresql://pulsedesk:pulsedesk@localhost:5432/pulsedesk?schema=public

# Local Redis connection matching docker-compose defaults.
REDIS_HOST=localhost
REDIS_PORT=6379

# Local Next.js client URL used for CORS and auth redirects.
CLIENT_URL=http://localhost:3000

# Clerk keys required by the NestJS API for validating Clerk session tokens.
# Replace these with values from the Clerk dashboard for local development.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk JWT verification settings.
# CLERK_JWT_KEY is optional but recommended for networkless token verification.
# Use the PEM public key from Clerk Dashboard > API keys > Show JWT public key.
# CLERK_AUTHORIZED_PARTY must match the Next.js frontend origin.
# Use a comma-separated list when multiple frontend origins are allowed.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTY=http://localhost:3000

# Gemini API key and model defaults.
# Replace GEMINI_API_KEY with a local development key; never commit real keys.
GEMINI_API_KEY=replace_me
GEMINI_GENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# PulseDesk stores 768-dimensional vectors by default to keep local pgvector storage small.
# gemini-embedding-2 supports configurable output dimensions, including 768.
EMBEDDING_DIM=768
